# Offline dashboard and demos do not need these values.
# Explicit model execution requires all three COMPUTER_USE values.
COMPUTER_USE_BASE_URL=
COMPUTER_USE_MODEL=
COMPUTER_USE_API_KEY=
JEV_BASE_URL=
NETEASE_APP_PATH=
# Explicit Guest/VM execution only; never reuse an old token/database.
AGENT_DESKTOP_VM_ID=
AGENT_DESKTOP_WORKER_URL=
AGENT_DESKTOP_TOKEN=
# Optional operator-owned JSON; defaults keep Physical input closed and Local Workspace unconfigured.
AGENT_DESKTOP_ENVIRONMENT_CONFIG=
