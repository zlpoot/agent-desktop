{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "testbench/p4/**/*.ts",
    "testbench/oracle-bridge.ts",
    "measurement/**/*.ts",
    "scripts/migrate-workflow-targets.ts"
  ]
}
